<idea-plugin url="https://github.com/VincentSteele/packageinfofirst">
    <id>de.vinste.packageinfofirst</id>
    <name>Package Info First</name>
    <vendor url="https://github.com/VincentSteele" email="vin.steele@proton.me">VincentSteele</vendor>

    <description><![CDATA[
        An IntelliJ IDEA plugin that makes dealing with <code>package-info.java</code> a little less annoying.
        <ul>
            <li>Pins <code>package-info.java</code> to the top of its package</li>
            <li>Adds a subtle badge to packages containing <code>package-info.java</code></li>
            <li>Provides an optional custom icon for <code>package-info.java</code></li>
            <li>Adds package context menu actions for creating, editing, and deleting <code>package-info.java</code></li>
            <li>Optionally hides <code>package-info.java</code> while keeping actions available from the package context menu</li>
        </ul>
    ]]></description>

    <change-notes><![CDATA[
        <!-- TODO: Add version 0.6.0 change notes before release. -->
    ]]></change-notes>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationConfigurable
                parentId="tools"
                id="de.vinste.packageinfofirst.settings"
                displayName="Package Info First"
                instance="de.vinste.packageinfofirst.PackageInfoConfigurable"/>
        <fileIconProvider implementation="de.vinste.packageinfofirst.PackageInfoIconProvider"/>
        <projectViewNodeDecorator
                implementation="de.vinste.packageinfofirst.PackageInfoProjectViewNodeDecorator"/>
        <treeStructureProvider
                implementation="de.vinste.packageinfofirst.PackageInfoTreeStructureProvider"
                order="last"/>
    </extensions>

    <actions>
        <action
                id="de.vinste.packageinfofirst.addPackageInfo"
                class="de.vinste.packageinfofirst.AddPackageInfoAction"
                text="Add Package Info"
                description="Create package-info.java for this package"
                icon="/icons/packageInfo.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action
                id="de.vinste.packageinfofirst.editPackageInfo"
                class="de.vinste.packageinfofirst.EditPackageInfoAction"
                text="Edit Package Info"
                description="Open this package's package-info.java in a preview tab"
                icon="/icons/packageInfo.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action
                id="de.vinste.packageinfofirst.deletePackageInfo"
                class="de.vinste.packageinfofirst.DeletePackageInfoAction"
                text="Delete Package Info"
                description="Delete this package's package-info.java"
                icon="/icons/packageInfo.svg">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
